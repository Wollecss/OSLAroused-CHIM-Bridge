# This file specifies files / folders which will be ignored by git.
#
# If you want to add one of these files to git, either remove the matching line from this
# file or force add the file/folder into git using `git -f add [path]`

# IDE / text editor profile files
.idea
.vs
.vscode/settings.json

# Possible C++ build output directories and files
out
build
cmake-build*
*.dll
*.pdb

# Skyrim archive files
*.bsa

# Build logs and packaged releases
build_output.txt
dist/

# Local tooling and notes, not part of the mod
build_plugin.bat
CLAUDE.md
phrases to use on npc.txt

# Runtime state written by the server extension, never source
plugin/ext/oslaroused_bridge/state.json
